{
  "name": "hotclock-streamdeck",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "description": "Stream Deck plugin for Hotclock radio automation",
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c -w",
    "test": "vitest run test/unit",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "typecheck": "tsc --noEmit",
    "pack": "npm run build && streamdeck validate com.neglectware.hotclock.sdPlugin && streamdeck pack com.neglectware.hotclock.sdPlugin --output dist --force"
  },
  "dependencies": {
    "@elgato/streamdeck": "^2.1.2"
  },
  "devDependencies": {
    "@elgato/cli": "^1.10.1",
    "@resvg/resvg-js": "^2.6.2",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.4",
    "@types/ws": "^8.18.2",
    "jsdom": "^30.1.2",
    "rollup": "^4.64.2",
    "tslib": "^2.8.1",
    "tsx": "^4.23.15",
    "typescript": "5.9",
    "vitest": "^5.0.3",
    "ws": "^8.22.0"
  }
}
